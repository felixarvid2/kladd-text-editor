<office:body><office:text><text:h text:style-name="Heading_20_1" text:outline-level="1">Bild</text:h><text:p text:style-name="Text_20_body">En bild: <draw:frame draw:style-name="Fr" draw:name="Bild1" text:anchor-type="as-char" svg:width="1.2in" svg:height="0.8in"><draw:image xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"><office:binary-data>iVBORw0KGgoAAAANSUhEUgAAADwAAAAoCAIAAAAt2Q6oAAAAQUlEQVR4nO3OAQkAIBAAsQ/2/TGWMTxhsACbs/udeT6QDpOWlg6QlpYOkJaWDpCWlg6QlpYOkJaWDpCWlg74Mn0B00S4pjNeSgUAAAAASUVORK5CYII=</office:binary-data></draw:image><svg:title>Röd ruta</svg:title></draw:frame> mitt i texten.</text:p><text:h text:style-name="Heading_20_1" text:outline-level="1">Listor</text:h><text:list text:style-name="L1"><text:list-item><text:p text:style-name="Text_20_body">Punkt ett</text:p><text:list><text:list-item><text:p text:style-name="Text_20_body">Underpunkt</text:p></text:list-item></text:list></text:list-item><text:list-item><text:p text:style-name="Text_20_body">Punkt två</text:p></text:list-item></text:list><text:list text:style-name="L2"><text:list-item><text:p text:style-name="Text_20_body">Första</text:p><text:list><text:list-item><text:p text:style-name="Text_20_body">Delsteg a</text:p></text:list-item><text:list-item><text:p text:style-name="Text_20_body">Delsteg b</text:p></text:list-item></text:list></text:list-item><text:list-item><text:p text:style-name="Text_20_body">Andra</text:p></text:list-item></text:list></office:text></office:body></office:document>