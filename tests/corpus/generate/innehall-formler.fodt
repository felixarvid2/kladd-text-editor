<office:body><office:text><text:table-of-content text:name="TOC"><text:table-of-content-source text:outline-level="2"/><text:index-body><text:index-title text:name="TOCT"><text:p text:style-name="Heading_20_1">Innehåll</text:p></text:index-title><text:p text:style-name="Contents_20_1">Inledning<text:tab/>1</text:p><text:p text:style-name="Contents_20_1">Formler<text:tab/>1</text:p></text:index-body></text:table-of-content><text:h text:style-name="Heading_20_1" text:outline-level="1">Inledning</text:h><text:p text:style-name="Text_20_body">Text före formeln.</text:p><text:h text:style-name="Heading_20_1" text:outline-level="1">Formler</text:h><text:p text:style-name="Text_20_body">Kvadratsatsen: <draw:frame draw:style-name="Fr" draw:name="Formel1" text:anchor-type="as-char" svg:width="1.5in" svg:height="0.3in"><draw:object><math:math><math:semantics><math:mrow><math:msup><math:mrow><math:mo>(</math:mo><math:mi>a</math:mi><math:mo>+</math:mo><math:mi>b</math:mi><math:mo>)</math:mo></math:mrow><math:mn>2</math:mn></math:msup><math:mo>=</math:mo><math:msup><math:mi>a</math:mi><math:mn>2</math:mn></math:msup><math:mo>+</math:mo><math:mn>2</math:mn><math:mi>a</math:mi><math:mi>b</math:mi><math:mo>+</math:mo><math:msup><math:mi>b</math:mi><math:mn>2</math:mn></math:msup></math:mrow><math:annotation math:encoding="StarMath 5.0">(a+b)^2 = a^2 + 2ab + b^2</math:annotation></math:semantics></math:math></draw:object></draw:frame> slut.</text:p></office:text></office:body></office:document>